# IP Docker-хоста, доступный шлюзам SMG для Syslog и passive FTP.
PUBLIC_HOST=10.10.10.20
TZ=Asia/Novosibirsk

# Уже существующая external Docker-сеть Nginx Proxy Manager.
PROXY_NETWORK=proxy

# Сгенерируйте независимые случайные значения длиной не менее 32 символов.
POSTGRES_PASSWORD=replace-with-random-secret
CLICKHOUSE_PASSWORD=replace-with-random-secret
MINIO_ROOT_PASSWORD=replace-with-random-secret
SFTPGO_ADMIN_PASSWORD=replace-with-random-secret

# NPM завершает TLS, поэтому в production оставьте true.
SECURE_COOKIES=true

# ---------------------------------------------------------------------------
# Runtime tunables (AntiFraud projection, CDR coverage, VoIPmonitor, export)
# are managed in UI: Настройки → Параметры (GET/PATCH /api/system/runtime-settings).
# Values below are used ONLY to seed an empty DB on first boot; afterwards the
# UI/DB is authoritative. Defaults match production-sensible SMG fleet values.
# Vars marked "code default" are read by the binary but not injected by
# deploy/compose.yml — leave unset unless you extend compose yourself.
# ---------------------------------------------------------------------------
# CUSTOM_PROJECTION_ENABLED=true
# CUSTOM_PROJECTION_LOOKBACK=24h          # code default; not in compose.yml
# CUSTOM_PROJECTION_BATCH_SIZE=128
# CUSTOM_PROJECTION_MAX_EVENTS=50000
# CUSTOM_PROJECTION_THREADS=2
# CUSTOM_PROJECTION_MAX_MEMORY_BYTES=1073741824
# CUSTOM_PROJECTION_SLEEP=1s
# CUSTOM_PROJECTION_LEASE=2m              # code default; not in compose.yml
# CUSTOM_RESPONSE_TIMEOUT=5s             # code default; not in compose.yml
# CUSTOM_PAIRING_HORIZON=5m
# CUSTOM_RETRY_HORIZON=168h
# CUSTOM_ASSEMBLY_IDLE=2s                # code default; not in compose.yml
# CDR_COVERAGE_EXPECTED_GRACE=5m
# CDR_COVERAGE_LATE_THRESHOLD=10m
# CDR_COVERAGE_MISSING_TERMINAL=30m
# CDR_COVERAGE_RETRY_HORIZON=168h
# CDR_COVERAGE_WORKER_SLEEP=5s           # code default; not in compose.yml
# VOIPMONITOR_ENABLED=false
# VOIPMONITOR_API_URL=
# VOIPMONITOR_USER=
# VOIPMONITOR_PASSWORD=
# VOIPMONITOR_GUI_URL=
# VOIPMONITOR_CARD_URL_TEMPLATE=
# VOIPMONITOR_CALLID_WINDOW=30m
# VOIPMONITOR_FALLBACK_WINDOW=2m
# VOIPMONITOR_FALLBACK_WINDOW_MAX=10m
# VOIPMONITOR_WORKER_SLEEP=5s
# VOIPMONITOR_LEASE=2m
# VOIPMONITOR_MIN_SCORE=60
# VOIPMONITOR_DISAMBIGUITY_MARGIN=8
# VOIPMONITOR_NUMBER_SUFFIX_LEN=10
# VOIPMONITOR_RATE_LIMIT_PER_SEC=5
# VOIPMONITOR_USE_SHARE_URL=false
# Seed-only enrichment tokens (empty DB). Live config: Настройки → Параметры.
# PSTN_LOOKUP_URL=https://pstn.finenumbers.com/api/v1/lookup
# PSTN_LOOKUP_TOKEN=
# GEOIP_LOOKUP_URL=https://geoip.finenumbers.com/api/v1/lookup
# GEOIP_LOOKUP_TOKEN=
# CLICKHOUSE_ADMISSION_CAPACITY=8
# EXPORT_PAGE_SIZE=1000

# Container CPU/RAM limits are managed in UI: Настройки → Параметры → «Лимиты контейнеров».
# Seed-only (empty DB); after save download container-limits.env and recreate compose.
# COLLECTOR_API_CPUS=2
# COLLECTOR_API_MEMORY=2G
# COLLECTOR_EXPORT_CPUS=2
# COLLECTOR_EXPORT_MEMORY=2G
# COLLECTOR_MAINTENANCE_CPUS=2
# COLLECTOR_MAINTENANCE_MEMORY=2G
# COLLECTOR_CPUS=4
# COLLECTOR_MEMORY=4G

# Optional split-role ClickHouse credentials (infrastructure secrets — stay in .env).
# CLICKHOUSE_API_USER=collector_api
# CLICKHOUSE_API_PASSWORD=replace-with-random-secret
# CLICKHOUSE_EXPORT_USER=collector_export
# CLICKHOUSE_EXPORT_PASSWORD=replace-with-random-secret
# CLICKHOUSE_MAINTENANCE_USER=collector_maintenance
# CLICKHOUSE_MAINTENANCE_PASSWORD=replace-with-random-secret

# Host-network ingress занимает этот UDP-порт напрямую и сохраняет source IP SMG.
SYSLOG_PORT=514
FTP_PORT=21
